generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              Int      @id @default(autoincrement())
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  month           String?
  // destination (희망 지역) and region (하객 수) are only set on leads from the
  // earlier regional wedding-hall flow — the studio flow collects residence instead.
  destination     String?
  budget          String?
  region          String?
  residence       String?
  name            String?
  phone           String?
  selectedResorts String?  @map("selected_resorts")
  status          String   @default("신규")
  memo            String?
  ip              String?  @map("ip_address")

  @@index([ip])
  @@map("leads")
}

model BlockedIp {
  id        Int      @id @default(autoincrement())
  ip        String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@map("blocked_ips")
}

model ChatbotConfig {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chatbot_config")
}

model AdminAccount {
  id           Int      @id @default(1)
  username     String
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_account")
}

model NotificationSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_settings")
}

// Admin-uploaded studio photos, served publicly by /api/images/[id]. Stored in
// Postgres so uploads work with only the existing DATABASE_URL — the admin UI
// downscales photos client-side first, so rows stay a few hundred KB each.
model UploadedImage {
  id          String   @id @default(uuid())
  data        Bytes
  contentType String   @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("uploaded_images")
}
